# Port the addon server runs on (Default: 7860)
PORT=7860

# Public URL Stremio will use. MUST be https://your.domain for remote/VPS installs.
# Do NOT use https://IP:7860 unless uvicorn has SSL_CERTFILE/SSL_KEYFILE or a reverse proxy.
# Example with Caddy: https://stremio-tg.example.com
ADDON_URL=http://localhost:7860

# Optional API Key to secure your addon (e.g., Gvi4ShwFyYz...)
API_KEY=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Telegram Bot Token from @BotFather (required if USER_SESSION_STRING is not set)
BOT_TOKEN=

# Telegram User Session String (highly recommended to bypass 2GB file limit)
USER_SESSION_STRING=

# Comma-separated list of Telegram Channel IDs to index (e.g., -100xxxxxxxxxx, -100yyyyyyyyyy)
TELEGRAM_CHANNEL_ID=

# Optional: Channel ID to send play/stream logs to (e.g., -100zzzzzzzzzz)
LOG_CHANNEL_ID=

# Optional: Timezone for logging (e.g., Asia/Kolkata, UTC). Defaults to UTC.
TIMEZONE=UTC

# Optional: Cache duration in seconds for search queries (Default: 1800)
CACHE_TTL=1800

# Optional: direct TLS for uvicorn (prefer Caddy/Traefik instead)
# SSL_CERTFILE=/certs/fullchain.pem
# SSL_KEYFILE=/certs/privkey.pem

# --- Optional Hebrew metadata-approval workflow ---
# This entire feature is opt-in. If left unset, the addon behaves exactly as
# before (Cinemeta + filename fuzzy search only). All four of ADMIN_BOT_TOKEN,
# MANAGEMENT_GROUP_ID, SUPABASE_URL, and SUPABASE_SERVICE_ROLE_KEY are required
# together to enable it; TMDB_BEARER_TOKEN is optional on top of that (Hebrew
# title search is skipped if unset, manual tt entry still works).
#
# ADMIN_BOT_TOKEN: token for a SEPARATE BotFather bot used only for the Hebrew
# group workflow (do NOT reuse this as BOT_TOKEN above). Must be an admin in
# the group with Privacy Mode disabled (BotFather -> /setprivacy -> Disable).
# ADMIN_BOT_TOKEN=

# MANAGEMENT_GROUP_ID: the private Telegram group's id (e.g. -1001234567890).
# Everyone in this group can upload files and approve/edit metadata.
# MANAGEMENT_GROUP_ID=

# TMDB_BEARER_TOKEN: TMDb "API Read Access Token" (v4 auth), used for
# Hebrew-first title search and IMDb id resolution. Get it from
# TMDb -> Settings -> API -> API Read Access Token.
# TMDB_BEARER_TOKEN=

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: server-only Supabase credentials
# used to persist approved metadata mappings. Never expose the service-role
# key to Telegram, Stremio, or any client-facing response.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional TorBox debrid (web URLs + magnets) ---
# Used when a link/magnet is posted in the management group: downloads via
# TorBox API, maps metadata with the same Hebrew Q&A, streams via TorBox CDN.
# TORBOX_API_KEY=
